# Contact form. Mail goes out through Zoho SMTP (smtppro.zoho.com, port 465, SSL).
# Set all three in Vercel for every environment, and in .env.local for `bun dev`. .env.local is gitignored.

# The Zoho mailbox that authenticates. It is also the From address on every message.
CONTACT_SMTP_USER=
# An app-specific password for that mailbox (Zoho Mail > My Account > Security > App Passwords).
CONTACT_SMTP_PASS=
# Where messages are delivered.
CONTACT_TO=
